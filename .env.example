# Copy this file to .env and fill in your values
DATABASE_URL=postgresql://username:password@localhost:5432/newspapers

# Your newspapers.com username (shown on the My Clippings tab)
NCOM_USERNAME=your-username

# Optional: path to cookies file (default: cookies.txt in project root)
# COOKIES_FILE=cookies.txt

# Optional: directory to save images (default: images/ in project root)
# IMAGES_DIR=images
